generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String    @id // matches Supabase Auth's user ID — not a separately generated UUID
  email                 String    @unique
  name                  String? // first name — set at signup; also the only name column that predates lastName
  lastName              String?
  phone                 String?
  role                  Role      @default(USER)
  emergencyContactName  String?
  emergencyContactPhone String?
  notifyEmailUpdates    Boolean   @default(true)
  termsAcceptedAt       DateTime? // set right after sign-up succeeds; null for accounts created before this field existed
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  deletedAt             DateTime? // set when the user deletes their account. The row itself is kept (PII scrubbed)
  // rather than hard-deleted, since Contract/Application rows are permanent
  // history (see Contract.endedAt comment) and their userId FK would block a
  // real delete anyway — same soft-delete shape as Home/Room.deletedAt.

  interests     Interest[]
  contracts     Contract[]
  applications  Application[]
  roomQuestions RoomQuestion[]
}

enum Role {
  USER
  ADMIN
}

model Home {
  id           String    @id @default(uuid())
  name         String
  description  String
  address      String
  wifiPassword String?
  binDay       String? // free text, e.g. "Tuesday (general), Thursday (recycling)"
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime? // null = active; soft-deleted so an accidental delete is restorable from the admin Trash

  photos        Photo[]
  rooms         Room[]
  announcements Announcement[]
}

model Room {
  id                  String     @id @default(uuid())
  title               String
  subtitle            String? // short admin-written blurb shown under photos; ~15 words, enforced in the UI
  description         String // amenities, deposit info, etc. described manually — listings are short
  price               Int // stored in cents to avoid float rounding bugs
  leaseLength3Months  Boolean    @default(false) // fixed set of 3 (3/6/12 month) options, enforced in UI, not the DB
  leaseLength6Months  Boolean    @default(true)
  leaseLength12Months Boolean    @default(false)
  status              RoomStatus @default(AVAILABLE)
  homeId              String
  pendingSince        DateTime? // set when status flips to PENDING_DEPOSIT, cleared otherwise
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  deletedAt           DateTime? // null = active; soft-deleted so an accidental delete is restorable from the admin Trash

  home          Home           @relation(fields: [homeId], references: [id])
  photos        Photo[]
  interests     Interest[]
  contracts     Contract[]
  applications  Application[]
  roomQuestions RoomQuestion[]
}

enum RoomStatus {
  AVAILABLE
  PENDING_DEPOSIT
  RENTED
  ARCHIVED
}

model Application {
  id     String            @id @default(uuid())
  userId String
  roomId String
  status ApplicationStatus @default(DRAFT)

  // Step 1 — Personal details
  legalFirstName     String?
  legalLastName      String?
  dateOfBirth        DateTime?
  phone              String?
  email              String?
  currentAddress     String?
  preferredMoveIn    DateTime?
  intendedStayMonths Int?

  // Step 2 — Identity verification. Drives which upload is *required* at
  // submit time; all upload fields are always shown in the UI, so no
  // client-side show/hide logic is needed.
  isAustralianCitizen Boolean?

  // Step 3 — Income & employment
  employmentStatus EmploymentStatus?
  employerName     String?
  employerContact  String?

  // Step 4 — Rental history & references. Inline, not a child table: fixed
  // cap of 2 references, matching how this schema avoids child tables/JSON
  // for small bounded data.
  previousAddress  String?
  landlordContact  String?
  reasonForLeaving String?
  reference1Name   String?
  reference1Phone  String?
  reference1Email  String?
  reference2Name   String?
  reference2Phone  String?
  reference2Email  String?
  aboutMe          String?

  submittedAt DateTime?
  reviewedAt  DateTime?
  rejectedAt  DateTime?
  // Set only on rejection (rejectedAt + 60 days) and read by the cleanup
  // cron (src/app/api/cron/application-cleanup). Left null otherwise, so
  // approved applications are never swept up — no separate "is now a
  // tenancy" flag is needed until a future session links Application to
  // Contract on approval.
  deleteAfter DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User                  @relation(fields: [userId], references: [id])
  room      Room                  @relation(fields: [roomId], references: [id])
  documents ApplicationDocument[]

  @@index([status, deleteAfter]) // for the daily cleanup cron's scan
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum EmploymentStatus {
  EMPLOYED_FULL_TIME
  EMPLOYED_PART_TIME
  SELF_EMPLOYED
  STUDENT
  UNEMPLOYED
  OTHER
}

enum ApplicationDocumentType {
  PRIMARY_ID
  SECONDARY_ID
  VISA_GRANT_NOTICE
  PROOF_OF_INCOME
  ENROLMENT_CONFIRMATION
}

model ApplicationDocument {
  id            String                  @id @default(uuid())
  applicationId String
  type          ApplicationDocumentType
  // Raw Supabase Storage path, not a public URL — the bucket is private
  // (personal ID docs), unlike Photo.url/Document.url. Signed URLs are
  // generated on demand (src/lib/application-documents.ts).
  path          String
  fileName      String
  createdAt     DateTime                @default(now())

  application Application @relation(fields: [applicationId], references: [id])
  // Re-uploading a document of the same type replaces the row in app code
  // (src/lib/application-documents.ts) — no unique constraint needed here,
  // same as Photo's "exactly one of room/home" invariant.
}

model Photo {
  id     String  @id @default(uuid())
  url    String
  order  Int     @default(0) // 0 = primary/first photo shown
  roomId String?
  homeId String?

  // Exactly one of room/home is set, enforced in app code — photos are
  // always created via a nested write under Room.photos or Home.photos.
  room Room? @relation(fields: [roomId], references: [id])
  home Home? @relation(fields: [homeId], references: [id])
}

model Interest {
  id         String    @id @default(uuid())
  userId     String
  roomId     String
  createdAt  DateTime  @default(now())
  notifiedAt DateTime? // null = not yet emailed

  user User @relation(fields: [userId], references: [id])
  room Room @relation(fields: [roomId], references: [id])

  @@unique([userId, roomId]) // one "notify me" per user per room, kept as permanent history
}

model Contract {
  id                 String    @id @default(uuid())
  userId             String
  roomId             String
  agreedAt           DateTime  @default(now())
  contractVersion    String // e.g. "v1.0" — ties signature to a specific T&Cs doc
  leaseLengthMonths  Int // snapshotted at signing time, independent of the room's current listing
  depositConfirmed   Boolean   @default(false)
  depositConfirmedAt DateTime?
  overridePriceCents Int? // per-tenant negotiated deal; null = use Room.price as normal

  // Manual bank-transfer rent tracking — no Invoice records, the bank's own
  // transfer confirmation is the source of truth. nextRentDueDate is null
  // until an admin sets it (either via confirmDeposit, or the first time
  // they touch this tenant's row on /admin/tenants).
  nextRentDueDate       DateTime?
  rentTenantConfirmedAt DateTime? // tenant clicked "I've Paid"; a signal, not a transaction
  rentLastPaidAt        DateTime? // set only when an admin clicks "Mark Paid"

  // Set when an admin terminates the lease: the room goes back to AVAILABLE
  // and the tenant's ApplicationDocuments are deleted, but this Contract row
  // (and the User/Application it points to) is kept as archived history.
  endedAt           DateTime?
  terminationReason String? // optional admin-entered note, shown on the previous-tenants archive

  user           User            @relation(fields: [userId], references: [id])
  room           Room            @relation(fields: [roomId], references: [id])
  invoices       Invoice[]
  checklistItems ChecklistItem[]
  rentPayments   RentPayment[]
}

// One row per "Mark Paid" click — the append-only history that
// Contract.rentLastPaidAt (a single overwritten "current status" field)
// doesn't keep. Deliberately separate from Invoice, which stays scoped to
// one-off charges per the manual bank-transfer rewrite.
model RentPayment {
  id          String   @id @default(uuid())
  contractId  String
  amountCents Int // snapshotted from Room.price/overridePriceCents at payment time, so later price changes don't rewrite history
  paidAt      DateTime @default(now())
  dueDate     DateTime // the nextRentDueDate this payment settles

  contract Contract @relation(fields: [contractId], references: [id])
}

enum InvoiceStatus {
  UPCOMING
  PAID
  // No stored OVERDUE — that's derived at display time from an UPCOMING
  // invoice whose dueDate has passed (see src/lib/invoices.ts), so nobody
  // has to remember to flip a status.
}

model Invoice {
  id          String        @id @default(uuid())
  contractId  String
  number      String // admin-entered, e.g. "INV-0001"
  amountCents Int
  dueDate     DateTime
  status      InvoiceStatus @default(UPCOMING)
  paidAt      DateTime?
  createdAt   DateTime      @default(now())

  contract Contract @relation(fields: [contractId], references: [id])
}

enum ChecklistStage {
  MOVE_IN
  MOVE_OUT
}

model ChecklistItem {
  id          String         @id @default(uuid())
  contractId  String
  stage       ChecklistStage
  label       String
  completed   Boolean        @default(false)
  completedAt DateTime?

  contract Contract @relation(fields: [contractId], references: [id])
}

model Announcement {
  id        String   @id @default(uuid())
  homeId    String
  title     String
  body      String
  createdAt DateTime @default(now())

  home Home @relation(fields: [homeId], references: [id])
}

enum DocumentType {
  HOUSE_RULES
  LEASE_TEMPLATE
  OTHER
}

model Document {
  id        String       @id @default(uuid())
  title     String
  type      DocumentType
  url       String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model ContactMessage {
  id         String    @id @default(uuid())
  name       String
  email      String
  message    String
  createdAt  DateTime  @default(now())
  readAt     DateTime? // null = unread
  archivedAt DateTime? // null = active; admin replies happen outside the app (mailto)
}

// Singleton row (id is always "singleton") holding the one bank account
// tenants transfer rent into. Free-text rather than structured BSB/account
// fields so it stays editable/country-agnostic without a schema change.
model PaymentSettings {
  id          String   @id @default("singleton")
  bankDetails String
  updatedAt   DateTime @updatedAt
}

model RoomQuestion {
  id         String    @id @default(uuid())
  userId     String
  roomId     String
  message    String
  createdAt  DateTime  @default(now())
  readAt     DateTime? // null = unread
  archivedAt DateTime? // null = active; admin replies happen outside the app (email)

  user User @relation(fields: [userId], references: [id])
  room Room @relation(fields: [roomId], references: [id])

  @@index([roomId])
}
